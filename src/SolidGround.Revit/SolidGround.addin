<?xml version="1.0" encoding="utf-8"?>
<!--
  SolidGround.Revit manifest.

  Hand-authored as a static template, not generated by RevitAddInManifest.SaveAs(): that API silently
  omits any <ManifestSettings> child that equals its own default (Issue #13 item 1), which would violate
  AGENTS.md's "set explicitly" requirement for UseAllContextsForDependencyResolution. The deploy script
  (Issue #14, scripts/Deploy-RevitAddIn.ps1) rewrites the <Assembly> element below to the absolute path of
  the versioned deployed DLL when it publishes; the bare file name here is the source-of-truth template
  value (conventions note section 3; verification note "Thin-host design", "Manifest" paragraph).

  The AddInId below is a freshly minted GUID, pinned here permanently: bb4d7576-b0fb-432b-a2c5-15c7ea59147d.
  Element set and required/optional status verified against the installed Revit 2027 SDK and Autodesk's
  2027 "Add-in Registration" (T1) documentation (Issue #13 items 1, 11).
-->
<RevitAddIns>
  <AddIn Type="Application">
    <Name>SolidGround</Name>
    <Assembly>SolidGround.Revit.dll</Assembly>
    <AddInId>bb4d7576-b0fb-432b-a2c5-15c7ea59147d</AddInId>
    <FullClassName>SolidGround.Revit.SolidGroundApplication</FullClassName>
    <VendorId>SolidGround</VendorId>
    <VendorDescription>SolidGround</VendorDescription>
  </AddIn>
  <ManifestSettings>
    <UseRevitContext>False</UseRevitContext>
    <ContextName>SolidGround</ContextName>
    <UseAllContextsForDependencyResolution>False</UseAllContextsForDependencyResolution>
  </ManifestSettings>
</RevitAddIns>
